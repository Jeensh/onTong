<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                              http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ontong.simulation</groupId>
    <artifactId>java-bridge</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>onTong Section 3 — Java Bridge</name>
    <description>
        slab-design 자바 시스템을 무수정으로 호출하기 위한 Spring Boot CLI.
        Oracle/Kafka 의존성은 @Primary @Bean override 로 mock 으로 swap.
        stdin JSON → SdDesigner.design() → stdout JSON.
    </description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
            slab-design 모듈들 — 사용자가 사전에:
                cd sample-repos/slab-design && ./mvnw install -DskipTests
            로 local m2 (~/.m2/repository) 에 jar 적재해야 함.
            groupId/artifactId 는 slab-design pom 의 정의 그대로.
        -->
        <dependency>
            <groupId>com.example.slabdesign</groupId>
            <artifactId>slab-design-feature</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <exclusions>
                <!-- Oracle JDBC / Kafka 는 mock 으로 대체 -->
                <exclusion>
                    <groupId>com.oracle.database.jdbc</groupId>
                    <artifactId>ojdbc11</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.kafka</groupId>
                    <artifactId>spring-kafka</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.example.slabdesign</groupId>
            <artifactId>slab-design-store</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Boot core -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- H2 in-memory DB (Oracle 대체) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson — JSON I/O -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>java-bridge-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.ontong.bridge.BridgeApp</mainClass>
                    <executable>true</executable>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
